{
	"name": "pi-websearch",
	"version": "0.4.0",
	"description": "Provider-backed web search tool for pi-coding-agent with config-gated activation, TUI status, and source-aware results.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/pi-websearch",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/pi-websearch.git"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"extension",
		"web-search",
		"exa",
		"tavily",
		"serpdive",
		"brave",
		"serper",
		"google-cse",
		"openai",
		"anthropic",
		"perplexity",
		"xai",
		"z-ai",
		"codex",
		"kagi",
		"kimi"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsgo --noEmit && biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@earendil-works/pi-tui": "0.87.1",
		"@types/node": "26.6.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typebox": "1.3.34",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
